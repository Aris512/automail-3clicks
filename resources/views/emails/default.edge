<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ subject }}</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            line-height: 1.6;
            color: #333;
            max-width: 600px;
            margin: 0 auto;
            padding: 20px;
        }
        .header {
            background-color: #f4f4f4;
            padding: 20px;
            text-align: center;
            border-radius: 5px;
        }
        .content {
            padding: 20px;
            background-color: #fff;
        }
        .footer {
            background-color: #f4f4f4;
            padding: 10px;
            text-align: center;
            font-size: 12px;
            color: #666;
            border-radius: 5px;
        }
    </style>
</head>
<body>
    <div class="header">
        <h1>Soporte Airie</h1>
    </div>
    
    <div class="content">
        <h2>{{ subject }}</h2>
        <p>{{ messaje }}</p>
    </div>
    
    <div class="footer">
        <p>Este es un correo automático de Soporte Airie</p>
    </div>
</body>
</html>
